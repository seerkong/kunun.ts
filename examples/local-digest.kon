(ai_workflow #localDigest
  :input = {scope = "今天的工作目录变更与笔记"}
  :output = [sourceList extracts digest]
  :[
    (ai_phase #Discover
      :[
        (var discovered (ai_agent #discoverSources :{
          label = "discover"
          sys_prompt = "你能用 shell 列举本地文件。只列出真实存在的文件，不要编造。"
          user_prompt =
          """
          用 shell（ls / find / glob）枚举与下面范围相关的本地资料，输出来源清单。

          范围：\(scope)
          """
          output_schema = {
            type = "object"
            properties = {
              sources = {
                type = "array"
                minItems = 1
                items = {
                  type = "object"
                  properties = {
                    path = {type = "string"}
                    why = {type = "string"}
                  }
                  required = ["path"]
                }
              }
            }
            required = ["sources"]
          }
        }))
        (var sourceList (discovered.:sources))
      ])
    (ai_phase #Extract
      :[
        (var extracts (ai_parallel #extractEach
          :{
            input = sourceList
            item = source
            index = i
          }
          :[
            (ai_agent #extractOne :{
              label = "extract-\(i)"
              sys_prompt = "你用 shell 读取单个本地文件并提炼有证据支撑的要点。不要读其它文件，不要编造。"
              user_prompt =
              """
              读取并提炼这个来源：
              路径：\((source.:path))
              关注：\((source.:why))

              提炼有据可查的要点，保留来源路径与原文片段作为证据。
              """
              output_schema = {
                type = "object"
                properties = {
                  path = {type = "string"}
                  items = {
                    type = "array"
                    items = {type = "string"}
                  }
                }
                required = ["path" "items"]
              }
            })
          ]))
      ])
    (ai_phase #Report
      :[
        (var digest (ai_agent #writeDigest :{
          label = "digest"
          sys_prompt = "你撰写忠实、有据可查的中文摘要。只用已提炼的内容，不重读文件、不编造。"
          user_prompt =
          """
          把下面各来源的提炼综合、去重、按价值排序，写成一份中文摘要，每条附来源路径作为证据。

          各来源提炼：
          \(extracts)
          """
        }))
      ])
  ])
