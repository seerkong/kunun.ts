(ai_workflow #fanOutReduce
  :input = {question = "Design a cache eviction strategy for a hot-key heavy workload"}
  :output = [drafts final]
  :[
    (ai_phase #Draft
      :[
        (var approaches ["LRU-first" "cost-aware" "adaptive-ttl"])
        (var drafts (ai_parallel #draftApproaches
          :{
            input = approaches
            item = approach
            index = i
          }
          :[
            (ai_agent #draftOne :{
              label = "draft-\(i)"
              sys_prompt = "You are a systems design writer."
              user_prompt =
              """
              Draft a short proposal for the question using the angle below.

              Question: \(question)
              Angle: \(approach)
              """
            })
          ]))
      ])
    (ai_phase #Synthesize
      :[
        (ai_log #drafted :{ message = "drafts ready: \(drafts)" })
        (var final (ai_agent #synthesize :{
          label = "synthesizer"
          sys_prompt = "You are an editor who merges competing drafts."
          user_prompt =
          """
          Synthesize the drafts below into a single recommendation.

          Drafts:
          \(drafts)
          """
        }))
      ])
  ])
