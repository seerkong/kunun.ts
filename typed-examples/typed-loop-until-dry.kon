(type #Seq <T>
  :[
    (method #length |-> Int|)
    (method #at |!Int index -> T|)
  ])

(type #SweepScope
  :[
    (!String field #path)
    (!String field #goal)
    ..never
  ])

(type #SweepRound
  :[
    (!Int field #index)
    (!SweepScope field #scope)
    (!Seq<String> field #seenFindingKeys)
    ..never
  ])

(type #FindingIdentity
  :[
    (!String field #key)
    (!String field #title)
    (!String field #location)
    ..never
  ])

(type #FindingDiagnosis
  :[
    (!String field #title)
    (!String field #detail)
    (!String field #severity)
    ..never
  ])

(type #FindingEvidence
  :[
    (!String field #file)
    (!Int field #line)
    (!String field #evidence)
    ..never
  ])

(type #IssueFinding
  @merge = [FindingIdentity FindingDiagnosis FindingEvidence])

(type #IssueBatch
  :[
    (!SweepRound field #round)
    (!Seq<IssueFinding> field #findings)
    (!Int field #count)
    (!Bool field #dry)
    ..never
  ])

(type #SweepAccumulator
  :[
    (!Int field #totalFindings)
    (!Int field #dryRound)
    (!Bool field #stopped)
    (!Seq<String> field #seenFindingKeys)
    ..never
  ])

(type #SweepOutput
  :[
    (!Int field #totalFindings)
    (!Int field #dryRound)
    (!Seq<IssueBatch> field #batches)
    ..never
  ])

(type #AgentRequest <TInput TOutput>
  :[
    (!String field #label)
    (!String field #sys_prompt)
    (!String field #user_prompt)
    (!TInput field #input)
    ..never
  ])

(type #AgentResult <TOutput>
  :[
    (!String field #label)
    (!TOutput field #value)
    ..never
  ])

#(effect decl #WorkflowAgent)
(type #WorkflowAgent
  :[
    (op #findIssues |!AgentRequest<SweepRound IssueBatch> request -> AgentResult<IssueBatch>|)
  ])

#(effect decl #WorkflowCheckpoint)
(type #WorkflowCheckpoint
  :[
    (op #save |!String label -> Unit|)
  ])

#(effect decl #WorkflowLog)
(type #WorkflowLog
  :[
    (op #write |!String message -> Unit|)
  ])

(fn #findingStableKey |!IssueFinding finding -> String|
  :[
    (finding.:key)
  ])

(fn #findingIdentityTitle |!IssueFinding finding -> String|
  :[
    (finding.:FindingIdentity:::title)
  ])

(fn #findingDiagnosisTitle |!IssueFinding finding -> String|
  :[
    (finding.:FindingDiagnosis:::title)
  ])

(fn #batchFindingCount |!IssueBatch batch -> Int|
  :[
    (batch.:count)
  ])

(fn #batchIsDry |!IssueBatch batch -> Bool|
  :[
    (:== (batch.:count) 0)
  ])

#(effect row :[ WorkflowAgent WorkflowCheckpoint WorkflowLog ])
(fn #typedLoopUntilDry |!SweepScope scope -> SweepOutput|
  :[
    (ai_workflow #typedLoopUntilDry
      :input_type = SweepScope
      :output_type = SweepOutput
      :effects = [WorkflowAgent WorkflowCheckpoint WorkflowLog]
      :input = scope
      :output = [totalFindings dryRound batches]
      :[
        (ai_phase #Sweep
          :input_type = SweepScope
          :state_type = SweepAccumulator
          :output_type = SweepOutput
          :effects = [WorkflowAgent WorkflowCheckpoint WorkflowLog]
          :[
            (var totalFindings 0)
            (var dryRound -1)
            (var batches [])
            (var seenFindingKeys [])

            (foreach round in [0 1 2 3]
              :item_type = Int
              :state_type = SweepAccumulator
              :break_when = batchIsDry
              :[
                (var roundInput {
                  index = round
                  scope = scope
                  seenFindingKeys = seenFindingKeys
                })

                (var batch (ai_agent #findIssues
                  :input_type = SweepRound
                  :output_type = IssueBatch
                  :effect = WorkflowAgent.findIssues
                  :{
                    label = "finder-round-\(round)"
                    input = roundInput
                    sys_prompt = "You are a meticulous bug finder. Return typed IssueBatch data only."
                    user_prompt =
                    """
                    Inspect \((scope.:path)) and report previously unseen issues only.

                    Goal:
                    \((scope.:goal))

                    This is round \(round).

                    Previously seen finding keys:
                    \(seenFindingKeys)
                    """
                  }))

                (set batches (batches batch :push))

                (if (batch batchIsDry)
                  :[
                    (set dryRound round)
                    (perform #WorkflowCheckpoint.save |"dry-round-reached"|)
                    (:break)
                  ]
                  else :[
                    (set totalFindings (totalFindings (batch batchFindingCount) :+))
                    (set seenFindingKeys (seenFindingKeys (batch.:findings) :append-finding-keys))
                    (perform #WorkflowCheckpoint.save |"round-has-findings"|)
                  ])
              ])

            (perform #WorkflowLog.write |"total \(totalFindings), dry at round \(dryRound)"|)
          ])
      ])
  ])
