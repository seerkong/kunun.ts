{
  "defaultAdapter": "claude",
  "concurrency": 8,
  "maxAgents": 200,
  "schemaRetries": 2,
  "timeout": 1800,
  "runsRoot": "~/.kwf/runs",
  "adapters": {
    "claude": {
      "label": "Claude Code",
      "command": ["claude", "--print", "--permission-mode", "acceptEdits"],
      "stdin": "{prompt}",
      "flags": { "model": ["--model"] }
    },
    "codex": {
      "label": "Codex CLI",
      "command": ["codex", "exec", "--skip-git-repo-check", "--cd", "{workspace}", "-"],
      "stdin": "{prompt}",
      "flags": { "model": ["--model"] }
    },
    "my_agent": {
      "label": "Custom agent CLI",
      "command": ["my-agent", "--cwd", "{workspace}", "--prompt-file", "{prompt_file}"]
    }
  }
}
