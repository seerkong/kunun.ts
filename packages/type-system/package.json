{
  "name": "kunun-type-system",
  "version": "1.0.4",
  "private": false,
  "main": "lib/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./lib/*.ts"
    }
  },
  "files": [
    "dist",
    "lib",
    "src"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com"
  },
  "dependencies": {
    "kunun-converter": "1.0.4",
    "kunun-core": "1.0.4",
    "kunun-runtime": "1.0.4"
  }
}
