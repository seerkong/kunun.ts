(var a [1 2 3])
(var breakResult 0)
(for :{i = 0} (i (:ArrayLength a) :lt) (++ i) :[
  (var x (a::i))
  (if (:== x 2) :[
    (:break)
  ])
  (set breakResult x)
])
(var continueResult 0)
(for :{i = 0} (i (:ArrayLength a) :lt) (++ i) :[
  (var x (a::i))
  (if (:== x 2) :[
    (:continue)
  ])
  (set continueResult x)
])
[breakResult continueResult]
