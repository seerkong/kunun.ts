(var ROUTING_CLASSIFICATION_OUTPUT_SCHEMA {
  type = "object"
  properties = {
    category = {type = "string"}
  }
  required = ["category"]
})

(ai_workflow #routing
  :input = {request = "Add dark mode to settings"}
  :output = [classification output grade]
  :[
    (ai_phase #Route
      :[
        (var request "Add dark mode to settings")
        (var classification (ai_agent #classifyRequest :{
          label = "classifier"
          sys_prompt = "You are a routing classifier for a coding workflow."
          user_prompt =
          """
          Classify this request into frontend, backend, or docs.

          Request:
          \(request)
          """
          output_schema = ROUTING_CLASSIFICATION_OUTPUT_SCHEMA
        }))
        (if (:== (classification.:category) "frontend") :[
          (var output (ai_agent #frontendSpecialist :{
            label = "frontend-specialist"
            sys_prompt = "You are the selected frontend specialist."
            user_prompt =
            """
            Handle the request as a frontend specialist.

            Request:
            \(request)

            Classification:
            \((classification.:category))
            """
          }))
        ] else :[
          (var output (ai_agent #generalSpecialist :{
            label = "general-specialist"
            sys_prompt = "You are the selected general coding specialist."
            user_prompt =
            """
            Handle the request as a general coding specialist.

            Request:
            \(request)

            Classification:
            \((classification.:category))
            """
          }))
        ])
      ])
    (ai_phase #Grade
      :[
        (var grade (ai_agent #gradeRoutedOutput :{
          label = "grader"
          sys_prompt = "You are an evaluator for routed coding work."
          user_prompt =
          """
          Grade the routed specialist output.

          Request:
          \(request)

          Output:
          \(output)
          """
        }))
      ])
  ])
