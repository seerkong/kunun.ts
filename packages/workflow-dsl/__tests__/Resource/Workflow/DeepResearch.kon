(var RESEARCH_PLAN_OUTPUT_SCHEMA {
  type = "object"
  properties = {
    angles = {type = "array"}
  }
  required = ["angles"]
})

(ai_workflow #deepResearch
  :input = {question = "What is a token-bucket rate limiter?"}
  :output = [question plan searchResults extracted votedClaims report]
  :[
    (ai_phase #Plan
      :[
        (var question "What is a token-bucket rate limiter?")
        (var plan (ai_agent #planResearch :{
          label = "planner"
          sys_prompt = "You are a research planner."
          user_prompt =
          """
          Plan research angles for the question.

          Question:
          \(question)
          """
          output_schema = RESEARCH_PLAN_OUTPUT_SCHEMA
        }))
      ])
    (ai_phase #Search
      :[
        (var searchResults (ai_parallel #searchAngles
          :{
            input = (plan.:angles)
            item = angle
            index = angleIndex
          }
          :[
            (ai_agent #searchAngle :{
              label = "search-\(angleIndex)"
              sys_prompt = "You are a source search worker."
              user_prompt =
              """
              Use WebSearch to find high-quality sources for this research angle.

              Main question:
              \(question)

              Angle:
              \((angle.:question))

              Suggested searches:
              \((angle.:searchQueries))
              """
            })
          ]))
      ])
    (ai_phase #Extract
      :[
        (var extracted (ai_parallel #extractClaims
          :{
            input = (plan.:angles)
            item = angle
            index = angleIndex
          }
          :[
            (ai_agent #extractBatch :{
              label = "extract-\(angleIndex)"
              sys_prompt = "You extract claims from researched sources."
              user_prompt =
              """
              Extract concrete, checkable claims from the source batch.

              Main question:
              \(question)

              Angle:
              \((angle.:question))

              Search result:
              \((searchResults::angleIndex))
              """
            })
          ]))
      ])
    (ai_phase #Vote
      :[
        (var votedClaims (ai_pipeline #claimReview
          :{
            input = extracted
            item = claimBatch
            value = review
            index = claimBatchIndex
          }
          :[
            (stage #SkepticA :[
              (ai_agent #skepticA :{
                label = "skeptic-a"
                sys_prompt = "You are a skeptical research claim reviewer."
                user_prompt =
                """
                Review this extracted claim batch skeptically.

                Batch index:
                \(claimBatchIndex)

                Claims:
                \(claimBatch)
                """
              })
            ])
            (stage #SkepticB :[
              (ai_agent #skepticB :{
                label = "skeptic-b"
                sys_prompt = "You are a citation quality reviewer."
                user_prompt =
                """
                Review this claim batch for citation quality.

                Original claims:
                \(claimBatch)

                Previous review:
                \(review)
                """
              })
            ])
            (stage #Vote :[
              (ai_agent #voteClaims :{
                label = "vote"
                sys_prompt = "You reconcile research claim reviews."
                user_prompt =
                """
                Accept claims that survive skeptical review.

                Claim batch:
                \(claimBatch)

                Latest review:
                \(review)
                """
              })
            ])
          ]))
      ])
    (ai_phase #Report
      :[
        (var report (ai_agent #writeReport :{
          label = "reporter"
          sys_prompt = "You write concise cited research reports."
          user_prompt =
          """
          Write a cited Markdown report from accepted claims.

          Question:
          \(question)

          Accepted claims:
          \(votedClaims)
          """
        }))
      ])
  ])
