(var DISCOVER_SESSIONS_OUTPUT_SCHEMA {
  type = "object"
  properties = {
    sessions = {type = "array"}
  }
  required = ["sessions"]
})

(var DAILY_DIGEST_OUTPUT_SCHEMA {
  type = "object"
  properties = {
    headline = {type = "string"}
    sections = {type = "array"}
  }
  required = ["headline" "sections"]
})

(ai_workflow #agentDailyDigest
  :input = {date = "2026-06-04"}
  :output = [date sessions items digest verified markdown]
  :[
    (ai_phase #Discover
      :[
        (var date "2026-06-04")
        (var sessions (ai_agent #discoverSessions :{
          label = "discover"
          sys_prompt = "You discover local coding sessions for a daily digest workflow."
          user_prompt =
          """
          Discover relevant local coding sessions for this date.

          Date:
          \(date)
          """
          output_schema = DISCOVER_SESSIONS_OUTPUT_SCHEMA
        }))
      ])
    (ai_phase #Extract
      :[
        (var items (ai_parallel #extractItems
          :{
            input = (sessions.:sessions)
            item = session
            index = sessionIndex
          }
          :[
            (ai_agent #extractSessionItems :{
              label = "extract-\(sessionIndex)"
              sys_prompt = "You extract digest facts from discovered coding sessions."
              user_prompt =
              """
              Extract evidence-backed digest items from this session.

              Session index:
              \(sessionIndex)

              Session:
              \(session)
              """
            })
          ]))
      ])
    (ai_phase #Synthesize
      :[
        (var digest (ai_agent #synthesizeDigest :{
          label = "synthesizer"
          sys_prompt = "You synthesize structured daily digest sections."
          user_prompt =
          """
          Synthesize daily digest sections from extracted items.

          Date:
          \(date)

          Extracted items:
          \(items)
          """
          output_schema = DAILY_DIGEST_OUTPUT_SCHEMA
        }))
      ])
    (ai_phase #Verify
      :[
        (var verified (ai_pipeline #verifyDigestItems
          :{
            input = items
            item = digestItem
            value = verifiedItem
            index = digestItemIndex
          }
          :[
            (stage #Dedupe :[
              (ai_agent #dedupeItems :{
                label = "dedupe"
                sys_prompt = "You are a verification pipeline stage for digest items."
                user_prompt =
                """
                Remove duplicate digest items.

                Item index:
                \(digestItemIndex)

                Item:
                \(digestItem)
                """
              })
            ])
            (stage #Verify :[
              (ai_agent #verifyItems :{
                label = "verify"
                sys_prompt = "You are a verification pipeline stage for digest items."
                user_prompt =
                """
                Verify this digest item against discovered session context.

                Original item:
                \(digestItem)

                Current item:
                \(verifiedItem)

                Sessions:
                \((sessions.:sessions))
                """
              })
            ])
          ]))
      ])
    (ai_phase #Report
      :[
        (ai_log #renderMarkdown :{
          message = "render markdown digest"
        })
        (var markdown (ai_agent #renderMarkdown :{
          label = "reporter"
          sys_prompt = "You render verified digest content as Markdown."
          user_prompt =
          """
          Render verified digest as Markdown.

          Digest:
          \(digest)

          Verified items:
          \(verified)
          """
        }))
      ])
  ])
