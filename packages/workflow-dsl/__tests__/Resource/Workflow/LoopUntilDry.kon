(ai_workflow #loopUntilDry
  :input = {target = "find x" maxRounds = 2}
  :output = [target rounds lastBatch]
  :[
    (ai_phase #Discover
      :[
        (var target "find x")
        (var rounds 0)
        (var lastBatch [])
        (var finders ["a" "b"])
        (for :{i = 0} (i 2 :lt) (++ i) :[
          (ai_log #roundStarted :{
            message = "discovery round \(i) started"
          })
          (set lastBatch (ai_parallel #roundDiscovery
            :{
              round = i
              join = "all"
              input = finders
              item = finder
              index = finderIndex
            }
            :[
              (ai_agent #finder :{
                label = "finder-\(finder)"
                sys_prompt = "You are a discovery worker in a bounded loop."
                user_prompt =
                """
                Discover fresh items for this round.

                Target:
                \(target)

                Round:
                \(i)

                Finder:
                \(finder)
                """
              })
            ]))
          (set rounds (rounds 1 :+))
        ])
      ])
  ])
