{
  "name": "kunun",
  "version": "1.0.3",
  "description": "kunun language: parser, runtime interpreter, and type system",
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "lib",
    "src"
  ],
  "scripts": {
    "dist": "bun build lib/index.ts --outfile dist/index.mjs --format esm --target node && bun build lib/index.ts --outfile dist/index.cjs --format cjs --target node"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com"
  },
  "dependencies": {
    "kunun-converter": "1.0.3",
    "kunun-core": "1.0.3",
    "kunun-runtime": "1.0.3",
    "kunun-type-annotations": "1.0.3",
    "kunun-type-system": "1.0.3"
  }
}
